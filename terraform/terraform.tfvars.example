# Copy this file to terraform.tfvars and fill in your values
project_id           = "your-gcp-project-id"
region               = "us-central1"
db_password          = "your-secure-random-password-here"
artifact_bucket_name = "your-project-mlflow-artifacts"

# Optional: customize service names
# db_instance_name       = "mlflow-db"
# artifact_registry_repo = "mlflow-docker"
# cloud_run_service_name = "mlflow-server"
